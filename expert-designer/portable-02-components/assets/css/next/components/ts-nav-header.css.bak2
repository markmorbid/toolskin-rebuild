@charset "UTF-8";
/* ═══════════════════════════════════════════════════════════════════════════
   TOOLSKIN · ts-nav-header.css — TOP NAVIGATION SYSTEM
Owner refactor final retouches. everythign working fine. needs   general design system consolidation on patterns. 

analyze and make  manual of implementation.  and reinforce hat is proiperly done. 
   ───────────────────────────────────────────────────────────────────────────
   MERGE PROVENANCE (this file)
   ────────────────────────────
   Architectural base = the clean 7-layer reconstruction. Merged INTO it: the
   owner's hand-tuned design decisions + token additions from ts-nav-header_2.css
   (owner decisions win on every conflict). Backup of the pre-merge base lives at
   ts-nav-header.css.bak. Merge log (owner-confirmed calls):
     • nav font multiplier kept at the owner's ×0.78 (stale "9.9px" comment dropped)
     • imported MOTION tokens are NAV-SCOPED (LAYER 2), NOT global — they do not
       override primitives/motion.css page-wide (owner call #2)
     • back-to-top floating variant DEFERRED — inline icon-item only (owner call #3)
     • full ts-ui-select internals DEFERRED — trigger styling only here (call #4)
     • .ts-btn--outline/--ghost consolidation NOT merged here → it's ts-btn_v3
       work; see TODO at end of file (owner call #5)
   Hard rules honored: zero !important · zero hardcoded hex · oklab color-mix
   everywhere EXCEPT the owner's srgb border system (--ts-border-* / --ts-nav-border).

   ─── ARCHITECTURE (strict layers — read top to bottom) ──────────────────────
     LAYER 0  Imported globals (:root)  z-index stack + border system (owner import)
     LAYER 1  Global primitives         external — primitives/*.css (NOT here)
     LAYER 2  Component-scoped tokens    nav heights/paddings/colors/MOTION/states
     LAYER 3  Structural                 topbar · fixed nav · mobile · sidenav shells
     LAYER 4  Primary selectors          logo · links · items · more · dropdown · controls
     LAYER 5  Secondary selectors        variants + states
     LAYER 6  Sub-elements               icons · labels · logo em/sub · burger lines
     LAYER 7  Assets / utilities         glass backdrop · overlay · theme-toggle anim

   LOAD ORDER  primitives/* → system/toolskin-this-bg-v2.css → components/
   ts-btn_v3.1.css → components/ts-nav-header.css → harness.css (scaffold only).
   Pair with ts-nav.js (burger/overflow/scroll-spy/theme/logo-fit) + ts-icons.js.
   ═══════════════════════════════════════════════════════════════════════════ */


/* ╔═══════════════════════════════════════════════════════════════════════════
   ║ LAYER 0 — IMPORTED GLOBALS (:root)   [owner import, item G]
   ║ These are GLOBAL coordination systems the component file was missing. They
   ║ live on :root deliberately until they get a proper home in the primitives
   ║ layer. NOTE: motion tokens are intentionally NOT here — they were moved to
   ║ the nav scope (LAYER 2) so nav timing never overrides the page globally.
   ╚═══════════════════════════════════════════════════════════════════════════ */
:root {
  /* OWNER NOTE: IMPORTED THESE IMPORTANT Z INDEX TOKENS THAT ARE USED FOR
     CONVERSION, Z ALLOCATION AND OCE-PANEL INTERACTION INSTANCES GLOBALLY.
     Use THESE ones — don't replace the ones allocated here. */
  /* ─── §1h  Z-INDEX STACK ────────────────────────────────────────────── */
  --ts-z-base: 0;
  --ts-z-raised: 10;
  --ts-z-dropdown: 100;
  --ts-z-sticky: 2000;
  --ts-z-panel: 500;
  --ts-z-modal: 17009;
  --ts-z-toast: 11000;
  --ts-z-cursor: 12000;
  --ts-z-offcanvas: 17000;
  --ts-z-offcanvas-panel: 17018;
  --ts-z-preloader: 20000;
  --ts-z-overlay: 10000;

  /* OWNER NOTE: IMPORTED THESE SMART BORDER TOKENS THAT WORK ACROSS LIGHT AND
     DARK MODE using the primary-text value + alpha dims to standardize borders.
     srgb is intentionally kept here (this is the owner's border system — the one
     documented exception to the oklab rule). */
  --ts-border-0: color-mix(in srgb, var(--ts-text-primary), transparent 94%);
  /* subtlest  */
  --ts-border-1: color-mix(in srgb, var(--ts-text-primary), transparent 90%);
  /* standard  */
  --ts-border-2: color-mix(in srgb, var(--ts-text-primary), transparent 84%);
  /* prominent */
  --ts-border-3: color-mix(in srgb, var(--ts-text-primary), transparent 80%);
  --ts-border-4: color-mix(in srgb, var(--ts-text-primary), transparent 76%);
}


/* ╔═══════════════════════════════════════════════════════════════════════════
   ║ LAYER 2 — COMPONENT-SCOPED TOKENS
   ║ Scoped to the nav subtrees only (NOT :root *). Every value derives from a
   ║ primitive or the v2 engine, so the header re-themes with the system.
   ╚═══════════════════════════════════════════════════════════════════════════ */
:where(.ts-nav-fixed, .ts-nav-fixed *,
  .ts-nav-static, .ts-nav-static *,
  .ts-topbar, .ts-topbar *,
  .ts-mobile-menu, .ts-mobile-menu *,
  .ts-sidebar-menu, .ts-sidebar-menu *) {
  /* — Geometry — */
  --ts-topbar-h: 58px;
  /* canonical header height */
  --ts-nav-pad-inline: clamp(var(--ts-sp-3), 4vw, var(--ts-sp-6));

  /* — MOTION (owner-imported from showcase; NAV-SCOPED per owner call #2 so it
       never overrides primitives/motion.css globally). OWNER NOTE: imported the
       full preset set to ensure every animation token the nav needs is present. */
  --ts-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ts-ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ts-ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ts-ease-snap: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ts-ease-out-slow: cubic-bezier(0.25, 0.1, 0.25, 1);
  --ts-ease-in-slow: cubic-bezier(0.75, 0.8, 0.25, 1);
  --ts-ease-in-out-slow: cubic-bezier(0.25, 0.1, 0.25, 1);
  --ts-ease-out-linear: cubic-bezier(0.55, 0.055, 0.675, 0.19);
  --ts-ease-in-linear: cubic-bezier(0.215, 0.61, 0.355, 1);
  --ts-panel-ease-out: cubic-bezier(0.56, 0.29, 0.15, 1.19);
  --ts-panel-ease-in: cubic-bezier(0.73, 0.03, 0, 0.92);
  --ts-dur-fast: 220ms;
  --ts-dur-base: 300ms;
  --ts-dur-slow: 550ms;
  --ts-dur-slower: 700ms;
  --ts-transition: all var(--ts-dur-base) var(--ts-ease-out);

  /* — Type ramp (compressed nav scale). Base is an explicit 11px so nav density
       is independent of the page root font-size. Owner 2.2 tuning: ×0.899 +
       wider tracking. — */
  --ts-nav-fs-base: 11px;
  --ts-nav-fs: calc(var(--ts-nav-fs-base) * var(--ts-font-scale, 1));
  --ts-navlink-fs: calc(var(--ts-nav-fs) * 0.899);
  --ts-navlink-fw: 500;
  --ts-navlink-ls: var(--ts-tracking-wider);

  /* — Spacing multipliers (owner 2.2 chain) — */
  --ts-navlink-mult-lg: 1.75;
  --ts-navlink-mult-md: 1.25;
  --ts-navlink-mult-sm: 0.85;
  --ts-navlink-mult-xs: 0.5;
  --ts-navlink-gap: calc(var(--ts-navlink-fs) * var(--ts-navlink-mult-xs));
  --ts-navlink-pad-x: var(--ts-sp-2);
  --ts-navlink-pad-y: calc(var(--ts-navlink-pad-x) * var(--ts-navlink-mult-md));
  --ts-navlink-pad-x-mult: calc(var(--ts-navlink-pad-x) * var(--ts-navlink-mult-lg));
  --ts-navlink-pad-y-mult: calc(var(--ts-navlink-pad-y) * var(--ts-navlink-mult-sm));

  /* — Nav control (button/select/toggle) height — owner 2.2: topbar − pad-y·2 — */
  --ts-nav-btn-h: calc(var(--ts-topbar-h) - var(--ts-navlink-pad-y) * 2);
  --ts-btn-h: var(--ts-nav-btn-h);
  /* alias for ts-btn consumers */
  /* Max-height cap for pill controls (buttons + select trigger). */
  --ts-navlink-btn-max-h: calc(var(--ts-btn-h) - var(--ts-navlink-pad-y) * var(--ts-navlink-mult-xs));

  /* — Icon sizing (owner 2.2: ×mult-md / ×mult-lg) — */
  --ts-icon: calc(var(--ts-navlink-fs) * var(--ts-navlink-mult-md));
  --ts-icon-only-fs: calc(var(--ts-navlink-fs) * var(--ts-navlink-mult-lg));

  /* — ICON-ONLY ACTION ITEMS (@icontype-topnav-tokens). OWNER NOTE: these govern
       the toggle, burger and back-to-top so every full-height icon-only control
       shares ONE harmonic width + height. Height is topbar−1px so the divider
       never overlaps the header's bottom border. Owner 2.2 sizing: width =
       topbar − pad-x-mult; glyph = width·0.5. — */
  --ts-nav-icon-item-w: calc(var(--ts-topbar-h) - var(--ts-navlink-pad-x-mult));
  --ts-nav-icon-item-h: calc(var(--ts-topbar-h) - 1px);
  --ts-nav-icon-item-icon: calc(var(--ts-nav-icon-item-w) * 0.5);

  /* — Color roles. OWNER DECISION: nav ink = --ts-text-primary dimmed by a
       tunable alpha (NOT a fixed secondary), giving one softness knob. — */
  --ts-nav-text-alpha: 50%;
  --ts-text-primary-dim-nav: color-mix(in oklab, var(--ts-text-primary), transparent var(--ts-nav-text-alpha));
  --ts-navlink-color: var(--ts-text-primary-dim-nav);
  --ts-navlink-color-hover: var(--ts-text-primary);
  --ts-navlink-color-active: var(--ts-accent);
  --ts-navlink-bg: transparent;
  --ts-navlink-bg-hover: color-mix(in oklab, var(--ts-this-bg-hover), transparent 92%);
  --ts-navlink-bg-active: color-mix(in oklab, var(--ts-accent), transparent 92%);
  --ts-nav-active-bar: var(--ts-accent);
  /* active indicator bar (flips on accent) */

  /* — Header surface + chrome line. OWNER 2.2 DECISION: the border now derives
       from --ts-on-surface-auto (oklab) so it AUTO-INVERTS with the surface —
       the seed of the on-surface inversion system. Surface stays oklab too. — */
  --ts-nav-glass: 1;
  /* 1 = blur on, 0 = off */
  --ts-nav-glass-blur: 8px;
  --ts-nav-bg-alpha: 10%;
  /* header backdrop alpha */
  /* Border alpha: auto-inverting on-surface border. Owner: 16% read too strong;
     softened to 10% opacity (90% transparent) — subtle in dark, still visible in
     light. Tune here. */
  --ts-nav-border-alpha: 90%;
  --ts-nav-surface: color-mix(in oklab, var(--ts-this-bg), transparent var(--ts-nav-bg-alpha));
  --ts-nav-border: color-mix(in oklab, var(--ts-on-surface-auto), transparent var(--ts-nav-border-alpha));
  --ts-nav-border-active: color-mix(in oklab, var(--ts-on-surface-auto) calc(var(--ts-nav-bg-alpha) - 4%), var(--ts-navlink-bg-active) calc(var(--ts-nav-border-alpha) + 5%));
  /*Spécial ajusted accent implementation foir the accent on suyrfacxe type borders. needs yet to handle the dim better.*/
  /* — Radii + bars. Owner: the select trigger AND the pill buttons must share the
       SAME corner = the constrained header radius (--ts-header-ui-rad). The
       nav-btn-radius (slightly tighter) is kept only for full-height-adjacent UI. — */
  --ts-nav-ui-radius: calc(var(--ts-radius-constrained) * 1);
  --ts-nav-btn-radius: calc(var(--ts-nav-ui-radius) * 1);
  --ts-nav-dropdown-radius: calc(var(--ts-nav-ui-radius) + 1px);
  --ts-index-bar-height: 2px;
  /* active accent bar */

  /* — CONSTRAINED RADIUS. OWNER NOTE: caps the radius so a large --ts-radius-base
       can't break header UI. Applied on non-full-height buttons via
       --ts-header-ui-rad; full-height controls keep radius 0. — */
  --ts-radius-cap-raw: var(--ts-radius-md);
  --ts-radius-constrained: min(var(--ts-card-radius, var(--ts-radius-sm)), var(--ts-radius-cap-raw));
  --ts-header-ui-rad: var(--ts-radius-constrained);

  /* — Logo — */
  --ts-logo-color: var(--ts-text-primary);
  --ts-logo-sub-color: var(--ts-text-muted);
  /* Logo geometry tokens — declarative sizing contract; the live subtitle width
     is fitted at runtime by ts-nav.js. */
  --ts-header-logo-pad: var(--ts-navlink-pad-x);
  --ts-header-logo-w: calc(var(--ts-topbar-h) * 2);
  --ts-header-logo-max-w: calc(var(--ts-header-logo-w) - var(--ts-header-logo-pad) * 2);
  --ts-header-logo-h: calc(var(--ts-topbar-h) - var(--ts-header-logo-pad) * 2);
  --ts-header-logo-fs: var(--ts-fs-lead);
  --ts-header-logo-color: var(--ts-text-primary);
  --ts-header-logo-subtext-color: var(--ts-text-muted);
  --ts-header-logo-fs-adjust: 0.65;
  --ts-header-logo-subtext-fs-adjust: calc(var(--ts-header-logo-fs-adjust) * 0.375);
  --ts-header-logo-lh: 1.2;

  /* — Responsive switch + mobile/sidebar geometry (owner 2.2: collapse 720px).
       (The nav-scope --ts-z-sticky override was REMOVED so the header uses the
       canonical global z-stack value, 2000.) */
  --ts-nav-collapse-at: 720px;
  /* burger/mobile breakpoint */
  --ts-mobile-width: clamp(260px, 78vw, 360px);
  --ts-sidebar-nav-w: 200px;

  /* — Framework-select width (kept for the trigger; full select deferred) — */
  --ts-navlink-select-max-w: calc(var(--ts-btn-h) * 4);
  --ts-navlink-select-width: clamp(12ch, 20ch, 28ch);

  /* — Accent glow shadows (owner 2.2; used by the select dropdown later) — */
  --ts-shadow-accent-sm: inset 0 0 0 0 var(--ts-accent),
    0 4px 13px color-mix(in oklab, var(--ts-accent), transparent 70%);
  --ts-shadow-accent-lg: 0 0 0 0 var(--ts-accent),
    0 16px 60px color-mix(in oklab, var(--ts-accent), transparent 50%);

  /* — BURGER tokenization (owner item D) — lines fully tunable without touching
       structural CSS. — */
  --ts-burger-line-h: 2px;
  --ts-burger-line-radius: 1px;
  --ts-burger-line-distance: calc(var(--ts-burger-line-h) * 4);
  --ts-burger-line-dist-offset: calc(var(--ts-burger-line-distance) * -1);
  --ts-burger-line-w: calc(var(--ts-nav-icon-item-w) * 0.42);
  --ts-menu-burger-color: var(--ts-navlink-color);
  --ts-menu-burger-hover: var(--ts-navlink-color-hover);
  --ts-menu-burger-active: var(--ts-navlink-color-active);
  --ts-burger-transition-props: top, bottom, background-color, opacity, transform;

  /* — Bold-glyph text shadow for the accent logo letters (single, spaced def) — */
  --ts-shadow-bold-str: 0.45px;
  --ts-shadow-bold-str-n: calc(var(--ts-shadow-bold-str) * -1);
  --ts-shadow-bold:
    0 0 var(--ts-shadow-bold-str) currentColor,
    0 var(--ts-shadow-bold-str) 0 currentColor,
    var(--ts-shadow-bold-str) 0 0 currentColor,
    0 0 var(--ts-shadow-bold-str-n) currentColor,
    0 var(--ts-shadow-bold-str-n) 0 currentColor,
    var(--ts-shadow-bold-str-n) 0 0 currentColor;
}

/* Re-anchor the header surface so engine derivatives compute against the page
   floor (a parent may re-anchor to recolor the whole header in one line). */
:where(.ts-nav-fixed, .ts-nav-static, .ts-topbar, .ts-mobile-menu, .ts-sidebar-menu) {
  --ts-this-bg: var(--ts-bg-body);
}


/* ╔═══════════════════════════════════════════════════════════════════════════
   ║ LAYER 3 — STRUCTURAL SHELLS
   ╚═══════════════════════════════════════════════════════════════════════════ */

/* Shared header bar — fixed/static topnav + inline topbar share the SAME flex
   row contract; position differs per variant (LAYER 5). */
.ts-nav-fixed,
.ts-nav-static,
.ts-topbar {
  position: relative;
  isolation: isolate;
  /* own stacking context for the glass layer */
  display: flex;
  align-items: center;
  gap: 0;
  height: var(--ts-topbar-h);
  padding-inline: var(--ts-nav-pad-inline);
  color: var(--ts-navlink-color);
  border-bottom: 1px solid var(--ts-nav-border);
}

.ts-nav-fixed {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: var(--ts-z-sticky);
}

.ts-nav-static {
  position: static;
}

/* LAYER 7 dependency lives here structurally: glass backdrop is a pseudo so
   children (dropdowns) keep independent backdrop-filter contexts. */
.ts-nav-fixed::before,
.ts-mobile-menu::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background-color: var(--ts-nav-surface);
  backdrop-filter: blur(calc(var(--ts-nav-glass-blur) * var(--ts-nav-glass))) saturate(115%);
  transition: background-color var(--ts-dur-base) var(--ts-ease-out),
    backdrop-filter var(--ts-dur-base) var(--ts-ease-out),
    opacity var(--ts-dur-base) var(--ts-ease-out);
}

/* Link cluster — pushes right of the logo; truncating variant lets ts-nav.js
   relocate spillover into the ••• dropdown. */
.ts-nav-fixed__links {
  display: flex;
  flex-flow: row nowrap;
  align-items: stretch;
  align-self: stretch;
  margin-left: auto;
  gap: 0;
}

.ts-nav-fixed__links.ts-nav-truncate {
  flex: 0 0 auto;
  overflow: visible;
}

/* Items never squish — they fit, or overflow for ts-nav.js to relocate. */
.ts-nav-fixed__links>* {
  flex: none;
}

/* Mobile slide-in panel + scrim (LAYER 7 overlay). */
.ts-mobile-menu-overlay {
  position: fixed;
  inset: 0;
  z-index: calc(var(--ts-z-offcanvas-panel) - 1);
  background-color: var(--ts-this-bg-dim-2);
  opacity: 0;
  visibility: hidden;
  cursor: pointer;
  transition: opacity var(--ts-dur-base) var(--ts-ease-out),
    visibility var(--ts-dur-base) var(--ts-ease-out);
}

.ts-mobile-menu-overlay.active {
  opacity: 1;
  visibility: visible;
}

/* Single canonical mobile-menu rule (the dead right:-100% twin was deleted per
   owner cleanup item I). Slides in via transform; sits on the offcanvas layer. */
.ts-mobile-menu {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: auto;
  /* statically pinned right … */
  width: var(--ts-mobile-width);
  max-width: var(--ts-mobile-width);
  z-index: var(--ts-z-offcanvas-panel);
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow-y: auto;
  border-left: 1px solid var(--ts-nav-border);
  transform: translateX(100%);
  /* … and slid off-canvas via transform */
  visibility: hidden;
  transition: transform var(--ts-dur-slow) var(--ts-ease-in-out),
    visibility var(--ts-dur-slow) var(--ts-ease-in-out);
}

.ts-mobile-menu.active {
  transform: translateX(0);
  visibility: visible;
}

.ts-mobile-menu::before {
  --ts-nav-bg-alpha: 22%;
  --ts-nav-glass-blur: 13px;
}

/* Merged single .ts-mobile-menu-items (the two owner copies folded into one). */
.ts-mobile-menu-items {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  gap: 0;
  padding: 0;
  justify-content: center;
  align-content: stretch;
  align-items: stretch;
}


/* ╔═══════════════════════════════════════════════════════════════════════════
   ║ LAYER 4 — PRIMARY SELECTORS  (logo · links · items · more · dropdown · controls)
   ╚═══════════════════════════════════════════════════════════════════════════ */

/* ── 4.1  LOGO — column lockup; subtitle fitted to wordmark width by ts-nav.js. */
.ts-topbar__logo {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: calc(var(--ts-navlink-gap) * 0.4);
  height: 100%;
  max-width: var(--ts-header-logo-max-w);
  padding-inline: var(--ts-header-logo-pad);
  font-family: var(--ts-font-display);
  font-weight: var(--ts-fw-semibold);
  font-size: var(--ts-fs-lg);
  letter-spacing: var(--ts-tracking-wide);
  text-transform: uppercase;
  line-height: var(--ts-header-logo-lh);
  color: var(--ts-logo-color);
  text-decoration: none;
  flex: 0 0 auto;

  /* Wordmark — keeps TOOL + SKIN on one inline row; sets the lockup width. */
  & .ts-logo-brand {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }

  /* LAYER 6 — the accent word. */
  & em {
    color: var(--ts-accent);
    font-style: normal;
    font-weight: var(--ts-fw-black);
    text-shadow: var(--ts-shadow-bold);
  }

  /* Subtitle — own line; ts-nav.js sets font-size so its width === wordmark. */
  & span.ts-logo-sub,
  &>span:not(.ts-logo-brand) {
    display: block;
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    font-family: var(--ts-font-mono);
    font-size: 0.5em;
    /* starting size; ts-nav.js overrides to fit */
    font-weight: var(--ts-fw-normal);
    letter-spacing: normal;
    text-align: justify;
    text-align-last: justify;
    line-height: 1.2;
    color: var(--ts-logo-sub-color);
  }
}

/* ── 4.2  NAV ITEMS — shared base for fixed-links, dropdown, mobile items ───── */



/* Horizontal (topbar) items: full-height, padded inline, bottom accent bar. */
.ts-nav-fixed__links> :is(a, li, button, .ts-nav-item):not(.ts-btn) {
  height: 100%;
  padding-inline: var(--ts-navlink-pad-x-mult);
  justify-content: center;

  &::after {
    left: -1px;
    right: -1px;
    bottom: -1px;
    height: var(--ts-index-bar-height);
  }

  &:is(.active, .ts-active, [aria-current="page"])::after {
    background-color: var(--ts-nav-active-bar);
  }
}

.ts-nav-fixed__links,
.ts-nav-dropdown,
.ts-mobile-menu-items {
  &> :is(a, li, button, .ts-nav-item):not(.ts-btn) {
    display: inline-flex;
    align-items: center;
    gap: var(--ts-navlink-gap);
    position: relative;
    font-size: var(--ts-navlink-fs);
    font-weight: var(--ts-navlink-fw);
    letter-spacing: var(--ts-navlink-ls);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ts-navlink-color);
    background-color: var(--ts-navlink-bg);
    cursor: pointer;
    transition: color var(--ts-dur-fast) var(--ts-ease-out),
      background-color var(--ts-dur-fast) var(--ts-ease-out),
      border-color var(--ts-dur-fast) var(--ts-ease-out);

    /* LAYER 6 — leading icon */
    &>.ts-icon,
    &>i,
    &>ion-icon,
    & .ts-menu-icon {
      flex: none;
      display: grid;
      place-content: center;
      font-size: var(--ts-icon);
      width: var(--ts-icon);
      height: var(--ts-icon);
      color: var(--ts-navlink-color);
    }

    /* LAYER 6 — active/hover indicator bar (position set per context). */
    &::after {
      content: "";
      position: absolute;
      background-color: transparent;
      transition: background-color var(--ts-dur-base) var(--ts-ease-out),
        left var(--ts-dur-base) var(--ts-ease-out);
    }

    &:hover {
      color: var(--ts-navlink-color-hover);
    }

    &:hover> :is(.ts-icon, i, ion-icon, .ts-menu-icon) {
      color: var(--ts-navlink-color-hover);
    }

    &:is(.active, .ts-active, [aria-current="page"]) {
      color: var(--ts-navlink-color-active);
      background-color: var(--ts-navlink-bg-active);
    }

    &:is(.active, .ts-active, [aria-current="page"])> :is(.ts-icon, i, ion-icon, .ts-menu-icon) {
      color: var(--ts-navlink-color-active);
    }
  }
}

/* Horizontal (topbar) items: full-height, padded inline, bottom accent bar. */
.ts-nav-fixed__links {
  &> :is(a, li, button, .ts-nav-item):not(.ts-btn) {
    height: 100%;
    padding-inline: var(--ts-navlink-pad-x-mult);
    justify-content: center;

    &::after {
      left: -1px;
      right: -1px;
      bottom: -1px;
      height: var(--ts-index-bar-height);
    }

    &:is(.active, .ts-active, [aria-current="page"])::after {
      background-color: var(--ts-nav-active-bar);
    }
  }
}

/* ── 4.3  CONTROLS PARITY — pill buttons + select trigger are vertically
   centered; full-height icon-only controls are handled in 4.5. ─────────────── */
.ts-nav-fixed {

  .ts-btn,
  .ts-ui-select__trigger,
  &>.ts-btn,
  .ts-nav-fixed__links>.ts-btn {
    /* Center the button's icon+label in both axes — the height override above can
     otherwise leave ts-btn's intrinsic line-box sitting low/high (owner: "text
     looks offset, not centered"). */
    height: var(--ts-nav-btn-h);
    border-radius: var(--ts-nav-btn-radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    align-self: center;

  }

}




/* ── 4.4  MORE (•••) TRIGGER + DROPDOWN — shown once ts-nav.js sets .hasItems. */
.ts-nav-more {
  display: none;
  position: relative;
  align-self: stretch;

  &.hasItems {
    display: flex;
  }

  & .ts-more-trigger {
    appearance: none;
    background-color: transparent;
    border: 0;
    border-left: 1px solid var(--ts-nav-border);
    padding-inline: var(--ts-navlink-pad-x-mult);
    color: var(--ts-navlink-color);
    cursor: pointer;
    transition: color var(--ts-dur-fast) var(--ts-ease-out);

    &:hover {
      color: var(--ts-navlink-color-hover);
    }
  }

  &:hover>.ts-nav-dropdown,
  &.is-open>.ts-nav-dropdown,
  &[aria-expanded="true"]>.ts-nav-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
}

.ts-nav-dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  z-index: calc(var(--ts-z-sticky) + 1);
  display: flex;
  flex-direction: column;
  align-self: stretch;
  align-items: stretch;
  justify-items: stretch;
  min-width: 170px;
  background-color: var(--ts-nav-surface);
  backdrop-filter: blur(var(--ts-nav-glass-blur)) saturate(140%);
  border: 1px solid var(--ts-nav-border);
  border-top-width: 0px;
  outline: 0px solid var(--ts-nav-border);
  outline-offset: -1px;
  /* border-top: var(--ts-index-bar-height) solid var(--ts-accent);*/
  border-radius: 0 0 var(--ts-nav-dropdown-radius) var(--ts-nav-dropdown-radius);
  box-shadow: 0 10px 25px color-mix(in oklab, var(--ts-tone-floor), transparent 80%);
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--ts-dur-base) var(--ts-ease-out),
    visibility var(--ts-dur-base) var(--ts-ease-out);
  flex-wrap: wrap;
  align-content: stretch;

  &::before {
    content: "";
    left: -1px;
    right: -1px;
    top: -1px;
    bottom: auto;
    height: var(--ts-index-bar-height);
    background-color: var(--ts-nav-active-bar);

  }

  &> :is(a, li, button, .ts-nav-item):not(.ts-btn) {
    padding: var(--ts-navlink-pad-y-mult) var(--ts-navlink-pad-x-mult);

    &:not(:last-child) {
      border-bottom: 1px solid var(--ts-nav-border);
    }

    &::after {
      left: 0;
      top: 0;
      bottom: 0;
      width: var(--ts-index-bar-height);
      height: auto;
    }

    &:hover {
      background-color: var(--ts-navlink-bg-hover);
    }

    &:is(.active, .ts-active, [aria-current="page"])::after {
      background-color: var(--ts-nav-active-bar);
    }
  }

  /* Owner 2.2 smart spacing: base margin on every dropdown button, with
     first/last-of-row corrections so a button adjacent to nav-links gets extra
     top/bottom breathing space. */
  /* Button-type links relocated into the dropdown keep breathing room. */
  /* Base spacing for ALL ts-btn inside dropdown */
  &>.ts-btn {
    margin: var(--ts-nav-btn-block-gap) var(--ts-nav-btn-block-pad);
    align-self: stretch;
  }

  /* FIRST ts-btn (top breathing space correction) */
  &>.ts-btn:first-child,
  &> :not(.ts-btn)+.ts-btn {
    margin-top: var(--ts-nav-btn-block-pad);
  }

  /* LAST ts-btn (bottom breathing space correction) */
  &>.ts-btn:not(:has(+ .ts-btn)) {
    margin-bottom: var(--ts-nav-btn-block-pad);
  }
}

/* ── 4.5  ICON-ONLY ACTION ITEMS (@icontype-topnav-tokens) ────────────────────
   ONE shared rule for the theme toggle, burger and back-to-top so they share an
   identical harmonic footprint (owner item H). Full-height by default (the
   toggle is always full-height unless a button variant is set); the icon-item-h
   token (topbar−1px, top-aligned) leaves a 1px gap at the bottom so the divider
   never overlaps the header's bottom border. — */
.theme-toggle,
.ts-menu-burger,
#ts-top-btn,
.ts-back_top-nav {
  order: 90;
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  box-sizing: border-box;
  width: var(--ts-nav-icon-item-w);
  height: var(--ts-nav-icon-item-h);
  padding: 0;
  border: 0;
  border-left: 1px solid var(--ts-nav-border);
  border-radius: 0;
  background-color: transparent;
  color: var(--ts-navlink-color);
  font-size: var(--ts-nav-icon-item-icon);
  text-decoration: none;
  cursor: pointer;
  transition: color var(--ts-dur-fast) var(--ts-ease-out);
  --ts-navlink-color: var(--ts-text-muted);



  & .ts-icon,
  & i,
  & ion-icon {
    font-size: inherit;
    transition: color 400ms ease, transform 400ms ease, opacity 300ms ease;
  }

  &:hover {

    --ts-navlink-color: var(--ts-navlink-color-active);

  }
}

/* Theme toggle layout specifics (animation lives in LAYER 7). */
.theme-toggle {
  appearance: none;

  & input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  & .theme-toggle-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  & .theme-toggle__expand {
    width: 1em;
    height: 1em;
  }
}

/* Back-to-top is hidden until ts-nav.js reveals it (inline icon-item; the
   floating fixed variant is DEFERRED per owner call #3). */
#ts-top-btn,
.ts-back_top-nav {
  order: 80;
  /* display: none;*/
  display: inline-flex;

  &.active,
  &.ts-active {
    display: inline-flex;
  }

  & .ts-icon,
  & i,
  & ion-icon {
    display: inline-grid;
    place-content: center;
  }
}

/* ── 4.6  BURGER — 3-line → X (owner 2.2 exact structure). Sizing comes from the
   shared icon-item rule; this only defines the three lines + the X morph. ───── */
.ts-menu-burger {
  order: 95;
  display: none;
  /* shown at collapse width / on mobile */
  align-items: center;
  justify-content: center;

  & .ts-menu-burger-inner,
  & .ts-menu-burger-inner::before,
  & .ts-menu-burger-inner::after {
    content: "";
    position: absolute;
    width: 100%;
    display: block;
    transform-origin: center center;
    height: var(--ts-burger-line-h);
    background-color: inherit;
    border-radius: var(--ts-burger-line-radius);
    transition-duration: var(--ts-dur-slow);
    transition-timing-function: var(--ts-ease-in-out-slow);
    transition-property: var(--ts-burger-transition-props);
  }
}

/* Middle line — relative, centered; carries the burger color + the 225° spin. */
.ts-menu-burger .ts-menu-burger-inner {
  position: relative;
  display: block;
  margin-top: calc(var(--ts-burger-line-h) * -1);
  width: calc(var(--ts-nav-icon-item-icon) + var(--ts-burger-line-h));
  background-color: var(--ts-menu-burger-color);
  transition-property: transform, color, background-color;
  transition-duration: 0.3s;
  transition-timing-function: var(--ts-ease-out-linear);
}

.ts-menu-burger .ts-menu-burger-inner::before {
  top: calc(var(--ts-burger-line-distance) * -1);
}

.ts-menu-burger .ts-menu-burger-inner::after {
  bottom: calc(var(--ts-burger-line-distance) * -1);
}

.ts-menu-burger:hover .ts-menu-burger-inner {
  --ts-menu-burger-color: var(--ts-menu-burger-hover);
}

/* Open → X: middle line spins 225°, top line fades, bottom line rotates −90°. */
.ts-menu-burger.active .ts-menu-burger-inner {
  --ts-menu-burger-color: var(--ts-menu-burger-active);
  transform: rotate(225deg);
  transition-delay: var(--ts-dur-base);
  transition-duration: var(--ts-dur-slow);
  transition-timing-function: var(--ts-ease-in-out-slow);
}

.ts-menu-burger.active .ts-menu-burger-inner::before {
  top: 0;
  opacity: 0;
  transition: top 0.1s ease-out, opacity 0.1s 0.14s ease-out, background-color 0.15s ease;
}

.ts-menu-burger.active .ts-menu-burger-inner::after {
  bottom: 0;
  transform: rotate(-90deg);
  transition: bottom 0.1s ease-out, transform 0.3s 0.14s var(--ts-ease-in-linear), background-color 0.15s ease;
}

/* ── 4.7  FRAMEWORK SELECT — trigger-level only (full select internals DEFERRED,
   owner call #4). Owner 2.2: the select is a full-height divider CELL (left
   border like the icon items) that hosts a bordered pill trigger. Re-anchors
   --ts-this-bg to a faint input surface so the engine derives the pill. — */
.ts-nav-fixed .ts-ui-select {
  order: 3;
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  max-height: var(--ts-nav-icon-item-h);
  max-width: var(--ts-navlink-select-width);
  padding: 0;
  padding-inline: var(--ts-navlink-pad-y);
  border: 1px solid var(--ts-nav-border);
  border-block-width: 0;
  border-right-width: 0;
  background-color: transparent;
  color: var(--ts-navlink-color);
  font-size: var(--ts-navlink-fs);
  font-weight: var(--ts-navlink-fw);
  letter-spacing: var(--ts-navlink-ls);
  box-sizing: border-box;
  --ts-navlink-pad-y: calc(var(--ts-navlink-pad-x-mult) * 0.5);
  --ts-input-bg: color-mix(in oklab, var(--ts-this-bg), var(--ts-on-surface-auto) 5%);
  --ts-input-bg-hover: color-mix(in oklab, var(--ts-this-bg), var(--ts-on-surface-auto) 10%);
}

.ts-nav-fixed .ts-ui-select__native {
  display: none;
}

.ts-nav-fixed .ts-ui-select__trigger {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ts-navlink-gap);
  height: var(--ts-nav-btn-h);
  max-height: var(--ts-nav-btn-h);
  max-width: var(--ts-navlink-select-max-w);
  flex: 1 1 var(--ts-navlink-select-max-w);
  padding-inline: var(--ts-navlink-pad-x-mult);
  font: inherit;
  font-size: var(--ts-navlink-fs);
  text-transform: uppercase;
  letter-spacing: var(--ts-navlink-ls);
  color: var(--ts-navlink-color);
  --ts-this-bg: var(--ts-input-bg);
  background-color: var(--ts-this-bg-dim-2);
  /* owner 2.2 tone (dim-2 of the input anchor) */
  border: 1px solid var(--ts-nav-border);
  border-radius: var(--ts-nav-btn-radius);
  /* == --ts-header-ui-rad (matches buttons) */
  cursor: pointer;
  transition: color var(--ts-dur-fast) var(--ts-ease-out),
    background-color var(--ts-dur-fast) var(--ts-ease-out),
    border-color var(--ts-dur-fast) var(--ts-ease-out);

  &:hover {
    --ts-this-bg: var(--ts-input-bg-hover);
    background-color: var(--ts-this-bg-dim-2);
    color: var(--ts-navlink-color-hover);
  }

  & .ts-ui-select__value {
    display: inline-flex;
    align-items: center;
    gap: var(--ts-navlink-gap);
    text-transform: uppercase;
  }

  & .ts-ui-select__chevron {
    font-size: 0.8em;
    opacity: 0.7;
  }
}

/* Open-state ink shift (trigger-level; dropdown internals deferred). */
.ts-nav-fixed .ts-ui-select--open .ts-ui-select__trigger {
  color: var(--ts-navlink-color-active);
}


/* ╔═══════════════════════════════════════════════════════════════════════════
   ║ LAYER 5 — SECONDARY SELECTORS (variants · modifiers · states)
   ╚═══════════════════════════════════════════════════════════════════════════ */

/* ── 5.0  ACCENT-SURFACE LEGIBILITY (owner ask) ───────────────────────────────
   When the header (or an ancestor) is anchored on the accent, 50%-alpha primary
   ink is too faint. Re-derive nav ink + dividers + active bar from --ts-on-accent
   so everything stays legible. Token-level only — no hardcoded color. — */
:is(.ts-nav-fixed, .ts-nav-static, .ts-topbar, .ts-mobile-menu).ts-on-accent,
.ts-on-accent :is(.ts-nav-fixed, .ts-nav-static, .ts-topbar) {
  --ts-text-primary-dim-nav: color-mix(in oklab, var(--ts-on-accent), transparent var(--ts-nav-text-alpha));
  --ts-navlink-color-hover: var(--ts-on-accent);
  --ts-navlink-color-active: var(--ts-on-accent);
  --ts-nav-active-bar: var(--ts-on-accent);
  --ts-logo-color: var(--ts-on-accent);
  --ts-logo-sub-color: color-mix(in oklab, var(--ts-on-accent), transparent 35%);
  --ts-menu-burger-color: color-mix(in oklab, var(--ts-on-accent), transparent var(--ts-nav-text-alpha));
  --ts-nav-border: color-mix(in srgb, var(--ts-on-accent), transparent 72%);
}

/* ── 5.1  DEFAULT (non-spaced): vertical dividers between items ────────────── */
.ts-nav-fixed:not(.spaced):not(.ts-nav--spaced) .ts-nav-fixed__links> :is(a, li, button, .ts-nav-item):not(.ts-btn) {
  border-right: 1px solid var(--ts-nav-border);
}

.ts-nav-fixed:not(.spaced):not(.ts-nav--spaced) .ts-nav-fixed__links> :is(a, li, button, .ts-nav-item):not(.ts-btn):first-child {
  border-left: 1px solid var(--ts-nav-border);
}

.ts-nav-fixed:not(.spaced):not(.ts-nav--spaced) .ts-nav-fixed__links>.ts-btn {
  margin-left: var(--ts-navlink-gap);
}

/* The LAST button in the bar needs an end margin too (owner: it was stuck to the
   container edge / next divider). */
.ts-nav-fixed:not(.spaced):not(.ts-nav--spaced) .ts-nav-fixed__links>.ts-btn:last-child {
  margin-right: var(--ts-navlink-gap);
}

/* Button-type links keep a small gap from neighbours in the default bar. */
.ts-nav-fixed:not(.spaced):not(.ts-nav--spaced) {
  .ts-nav-fixed__links {

    &>.ts-btn {
      margin-left: var(--ts-navlink-gap);
    }

    &> :not(.ts-btn)+.ts-btn,
    &>.ts-btn:first-of-type,
    &>.ts-btn:first-child {
      margin-left: var(--ts-navlink-pad-x);
    }

    &>.ts-btn:not(:has(+ .ts-btn)),
    &>.ts-btn:last-child,
    &>.ts-btn:last-of-type {
      margin-right: var(--ts-navlink-pad-x);
    }
  }

}

/* ── 5.2  SPACED — gap-driven, no dividers, inline buttons ─────────────────── */
.ts-nav-fixed.spaced,
.ts-nav-fixed.ts-nav--spaced {

  .ts-nav-fixed__links,
  .ts-nav__links {
    gap: var(--ts-navlink-gap);
    align-items: center;
    padding-inline: var(--ts-navlink-pad-y-mult);

    &> :is(a, li, button, .ts-nav-item):not(.ts-btn) {
      --ts-nav-icon-item-w: calc(var(--ts-topbar-h) - var(--ts-navlink-pad-x-mult)*2);
      border-radius: var(--ts-nav-ui-radius);
      height: var(--ts-nav-icon-item-w);
      min-height: unset;
      max-height: var(--ts-nav-icon-item-w);
      border: 0px solid color-mix(in oklab, var(--ts-nav-border), transparent 60%);

      outline: 0px solid color-mix(in oklab, var(--ts-nav-border), transparent 60%);

      &:after {
        bottom: calc(var(--ts-navlink-pad-x-mult)*-1 - 1px);
      }

      &:hover,
      &.active,
      &.ts-active {
        outline-width: 1px;
        outline-offset: -1px;
      }

      &:hover:not(.active, .ts-active) {
        background-color: var(--ts-navlink-bg-hover) !important;
      }

    }

    &>.ts-btn {
      padding-inline: var(--ts-navlink-pad-x-mult);
      --ts-btn-scale: .8;
    }
  }

  &.ts-tabbed {

    .ts-nav-fixed__links,
    .ts-nav__links {
      gap: var(--ts-navlink-gap);
      align-items: center;
      padding-inline: var(--ts-navlink-pad-y-mult);

      &> :is(a, li, button, .ts-nav-item):not(.ts-btn) {
        /* border: 0; */
        border-radius: var(--ts-nav-ui-radius) var(--ts-nav-ui-radius) 0 0;
        height: var(--ts-nav-icon-item-h);
        max-height: calc(var(--ts-nav-icon-item-h) - var(--ts-navlink-pad-y-mult));
        outline-width: 0px !important;
        border: 1px solid color-mix(in oklab, var(--ts-nav-border), transparent 60%);
        border-bottom-width: 0px;
        align-self: end;
        padding-inline: var(--ts-navlink-pad-x-mult);

        &:after {
          bottom: -1px;
        }

      }

      &>.ts-btn {
        padding-inline: var(--ts-navlink-pad-x-mult);
        --ts-btn-scale: .8;
      }
    }

  }
}



/* ── 5.3  ICON-ONLY (desktop) — collapse labels, enlarge icon ─────────────── */
.ts-nav-fixed.ts-nav--icon-only .ts-nav-fixed__links,
.ts-nav-fixed__links.ts-icon-only-nav {
  --ts-nav-icon-item-w: calc(var(--ts-topbar-h) - var(--ts-navlink-pad-y));
  --ts-navlink-mult-lg: 1.2;

  &> :is(a, li, button, .ts-nav-item):not(.ts-btn):has(.ts-icon, i, ion-icon) {
    align-items: center;
    place-content: center;
    display: inline-grid;

    min-width: var(--ts-nav-icon-item-w);
    max-height: var(--ts-nav-icon-item-h);
    max-width: var(--ts-nav-icon-item-w);
    min-height: var(--ts-nav-icon-item-w);
    height: 100%;
    gap: 0;

    &>.ts-menu-text {
      display: none;

    }

    &> :is(.ts-icon, i, ion-icon) {
      --ts-navlink-mult-lg: 1.3;

      font-size: var(--ts-icon-only-fs);
      width: 1em;
      height: 1em;
      aspect-ratio: 1;
      display: inline-block;
      /* Display block or inline block is the solution for the miss aligned   items or  icons  with nested elements. as the grid system ahs subpixel imperfections and is impossible to have them porperly aligned with oiverlappin  width, line height, font size, font scaling and other properties units.  so cons  that loooks misaligned, must be turned into display inline block.  not make this a general rule, juist a  fix  for the issue if it appears again. is not goof for building layouts.*/

    }

  }

  &>.ts-btn:has(.ts-menu-text):has(.ts-icon, i, ion-icon):not(.ts-back_top-nav) {
    --ts-nav-icon-item-w: calc(var(--ts-topbar-h) - var(--ts-navlink-pad-y-mult)*2);
    --ts-navlink-mult-lg: 1.2;
    --ts-navlink-mult-sm: .75;

    min-width: var(--ts-nav-icon-item-w);
    max-width: var(--ts-nav-icon-item-w);
    min-height: var(--ts-nav-icon-item-w);
    max-height: var(--ts-nav-icon-item-w);

    &>.ts-menu-text {
      display: none;

    }

    &> :is(.ts-icon, i, ion-icon) {
      --ts-navlink-mult-lg: 1.25;

      font-size: var(--ts-icon-only-fs);
      width: 1em;
      height: 1em;
      aspect-ratio: 1;
      display: inline-block;


    }
  }


}


/* ── 5.4  STATIC / STICKY position variants ───────────────────────────────── */
.ts-nav-fixed.ts-nav--static {
  position: static;
}

.ts-nav-fixed.ts-nav--sticky {
  position: sticky;
  top: 0;
}

.ts-nav-fixed,
[data-fixed-header],
.ts-nav-fixed.ts-nav--sticky {
  z-index: calc(var(--ts-z-sticky) + 2);
  --ts-z-sticky: calc(var(--ts-z-offcanvas) - 5);
}

/* ── 5.5  TRANSPARENT (scroll-spy at page top) — ts-nav.js toggles `.at-top` ── */
.ts-nav-fixed.at-top {
  --ts-nav-bg-alpha: 100%;
  --ts-nav-border-alpha: 100%;
  --ts-nav-text-alpha: 0%;
  --ts-text-muted: var(--ts-on-surface-auto);
  --ts-menu-burger-color: var(--ts-on-surface-auto);

  &::before,
  &::after,
  > :is(.theme-toggle, .ts-more-trigger, .ts-ui-select):not(.ts-btn),
  .ts-nav-fixed__links> :is(a, button, .ts-ui-select):not(.ts-btn) {
    backdrop-filter: none;
    --ts-nav-bg-alpha: 100%;
    --ts-nav-border-alpha: 100%;
    --ts-nav-text-alpha: 0%;
    --ts-text-muted: var(--ts-on-surface-auto);
  }

  .ts-nav-fixed__links {}

  .ts-more-trigger,
  .theme-toggle,
  #ts-top-btn,
  .ts-menu-burger,
  .ts-back_top-nav {
    --ts-nav-border-alpha: 100%;

    .ts-menu-burger-inner {
      --ts-menu-burger-color: var(--ts-on-surface-auto);

    }



  }

  .ts-back_top-nav,
  #ts-top-btn {
    .ts-icon {
      transform: rotate(270deg);
    }
  }
}

.ts-nav-fixed.at-top::before {
  backdrop-filter: none;

}

/* ── 5.6  BURGER OPEN — hide bar chrome, drop the glass, raise above the panel — */
.ts-nav-fixed:has(.ts-menu-burger.active) {
  border-bottom-color: transparent;
  background-color: transparent;
  box-shadow: none;
  z-index: calc(var(--ts-z-offcanvas-panel) + 5);

  &::before {
    opacity: 0;
    backdrop-filter: none;
  }

  & :is(.ts-nav-fixed__links, .ts-ui-select, .ts-nav-more) {
    visibility: hidden;
  }

  & :is(.ts-topbar__logo, .theme-toggle) {
    opacity: 0;
    pointer-events: none;
  }

  .ts-menu-burger {
    z-index: calc(var(--ts-z-offcanvas-panel) + 5);
  }

  .ts-ui-select,
  .ts-ui-select__trigger {
    background: transparent !important;
    backdrop-filter: none !important;
    max-width: 0px !important;
    min-width: 0px !important;
    padding: 0px !important;
    width: 0px !important;
    overflow: hidden;
    border-color: transparent !important;
  }
}


/* ── 5.7  RESPONSIVE — collapse to burger + mobile menu (owner 2.2 breakpoint
   868px). SCOPED to the real fixed header via :not(.ts-nav--static) so the
   static demo navs keep ALL their links at any width. ── */
@media (max-width: 868px) {


  .ts-nav-fixed:not(.ts-nav--static) {
    z-index: calc(var(--ts-z-offcanvas-panel) + 5);

    .ts-nav-fixed__links,
    .ts-nav-more,
    .ts-nav-more.hasItems {
      display: none !important;
    }

    /* Burger shows (order 3), borderless, pushed to the end. */

    .ts-menu-burger {
      display: flex;
      order: 3;
      margin-right: 0;
      border-left-width: 1px;
      z-index: calc(var(--ts-z-offcanvas-panel) + 5);
    }

    /* Theme toggle sits just before the burger, borderless, pushed right. */

    .theme-toggle {
      order: 2;
      margin-left: auto;
      margin-right: 0;
      border-left-width: 0;
    }

    /* Framework select after the toggle. */

    .ts-ui-select {
      order: 4;
      transition-property: width, max-width, min-width, overflow, opacity, display, visibility, padding;
      transition-behavior: allow-discrete;
      transition-delay: .3s;

      transition-duration: 300ms;
      transition-timing-function: ease;

      .ts-ui-select__trigger {
        transition-behavior: allow-discrete;
        overflow: hidden;
        transition-property: width, max-width, background, padding, min-width, border-color;
        transition-duration: 300ms;
        transition-timing-function: ease;
        transition-delay: .3s;
      }
    }

    /* OWNER 2.2: on mobile the back-to-top is NOT floating — it returns INTO the
     bar as a full-height divider cell (order 3), hidden until .active so it
     never sits behind the mobile menu. */
    #ts-top-btn,
    .ts-back_top-nav {
      position: static !important;
      order: 3;
      width: var(--ts-btn-h);
      max-width: var(--ts-btn-h);
      height: 100%;
      max-height: calc(var(--ts-topbar-h) - 1px);
      aspect-ratio: auto;
      padding-inline: var(--ts-navlink-pad-y);
      border: 0;
      border: 0px solid var(--ts-nav-border);
      border-radius: 0;
      background-color: transparent;
      /*opacity: 0;
        pointer-events: none;
        transform: translateX(100%);*/
      opacity: 1 !important;
      pointer-events: all !important;
      transform: translateX(0) !important;
      border-left-width: 1px;
      transition: opacity var(--ts-dur-base) var(--ts-ease-out),
        transform var(--ts-dur-base) var(--ts-panel-ease-in);

      .ts-icon {
        --ts-icon: calc(var(--ts-nav-btn-h) * 0.6);
        font-size: var(--ts-icon);
        width: 1em;
        height: 1em;
      }

      &.active,
      &.ts-active {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(0);
      }
    }
  }




}

.ts-nav-fixed:has(.ts-menu-burger.active) {

  #ts-top-btn,
  .ts-theme-toggle,
  .theme-toggle,
  .ts-menu-burger,
  .ts-ui-select {
    border: none !important;
  }

  .ts-nav-fixed__links>*:not(.ts-btn, .ts-menu-burger, .ts-btn.ts-back_top-nav, .ts-btn#ts-top-btn) {
    display: none;
  }

  .ts-ui-select__trigger {
    background: transparent !important;
    backdrop-filter: none !important;
  }

  .ts-ui-select,
  .ts-ui-select__trigger {
    background: transparent !important;
    backdrop-filter: none !important;
    max-width: 0px !important;
    min-width: 0px !important;
    padding: 0px !important;
    width: 0px !important;
    overflow: hidden;
    border-color: transparent !important;


  }

  border-bottom-color: transparent !important;
}

.ts-nav-fixed:has(.ts-menu-burger.active):before {
  opacity: 0;
  backdrop-filter: none !important;
}

/* Sub-420px: the framework select collapses to zero width (owner 2.2). */
@media (max-width: 420px) {

  .ts-nav-fixed:has(.ts-menu-burger.active) {

    #ts-top-btn,
    .ts-theme-toggle,
    .theme-toggle,
    .ts-menu-burger,
    .ts-ui-select {
      border: none !important;
    }

    .ts-nav-fixed__links>*:not(.ts-menu-burger, .ts-back_top-nav, #ts-top-btn) {
      display: none;
    }

    .ts-ui-select__trigger {
      background: transparent !important;
      backdrop-filter: none !important;
    }

    /* ui select shrink hiding with transition applied only on smaller mobile devices.  */

    .ts-ui-select,
    .ts-ui-select__trigger {
      background: transparent !important;
      backdrop-filter: none !important;
      max-width: 0px !important;
      min-width: 0px !important;
      padding: 0px !important;
      width: 0px !important;
      overflow: hidden;
      border-color: transparent !important;

    }

    border-bottom-color: transparent !important;
  }


  .ts-nav-fixed:not(.ts-nav--static) {

    .ts-ui-select,
    .ts-ui-select__trigger {
      max-width: 0;
      min-width: 0;
      width: 0;
      padding: 0;
      overflow: hidden;
      background-color: transparent;
      border-color: transparent;
      backdrop-filter: none;
    }
  }
}

.ts-nav-dropdown,
.ts-mobile-menu-items {
  --ts-nav-btn-block-gap: calc(var(--ts-navlink-gap)*var(--ts-navlink-mult-xs));
  --ts-nav-btn-block-pad: var(--ts-navlink-pad-x-mult);
  --ts-nav-bd-w: 1px;
  --ts-nav-bd-w-offset: calc(var(--ts-nav-bd-w)*-1);
  --ts-mobile-nav-bd-w: var(--ts-nav-bd-w);
  --ts-dropdown-nav-bd-w: var(--ts-nav-bd-w);
  --ts-mobile-nav-pad-y: calc(var(--ts-navlink-pad-y-mult) * var(--ts-navlink-scale-mult));
  --ts-mobile-nav-pad-x: calc(var(--ts-navlink-pad-x-mult) * var(--ts-navlink-scale-mult));
  --ts-mobile-nav-padding: var(--ts-mobile-nav-pad-y) var(--ts-mobile-nav-pad-x);

  --ts-mobile-navlink-fs: calc(var(--ts-nav-fs) * 1.1);
  --ts-navlink-scale-mult: 2;

}

/* Mobile items: vertical stripes with top/bottom borders + LEFT accent bar.
   Owner 2.2: font bumped ×1.1 for mobile readability, padding ×2, accent bar
   bleeds −1px over the row borders. */
.ts-mobile-menu-items {
  > :is(a, li, button, .ts-nav-item):not(.ts-btn) {
    --ts-navlink-fs: var(--ts-mobile-navlink-fs);

    justify-content: flex-start;
    padding: var(--ts-mobile-nav-padding);
    border: 0px solid var(--ts-nav-border);
    margin-bottom: var(--ts-nav-bd-w-offset);
    border-bottom-width: var(--ts-mobile-nav-bd-w);

    &::after {
      left: 0;
      top: var(--ts-nav-bd-w-offset);
      bottom: var(--ts-nav-bd-w-offset);
      width: var(--ts-index-bar-height);
      height: auto;
    }

    &:is(.active, .ts-active, [aria-current="page"])::after {
      background: var(--ts-accent);
      --ts-nav-border: var(--ts-nav-border-active);
    }

    &:is(.active, .ts-active, [aria-current="page"]) {
      --ts-navlink-bg: var(--ts-navlink-bg-active);
      --ts-nav-border: var(--ts-nav-border-active);
    }

    &:hover {
      --ts-navlink-bg: var(--ts-navlink-bg-hover);
    }
  }

  /* Owner 2.2 smart spacing in the mobile menu — top/bottom corrections use
   pad-x-mult (more vertical breathing room than the dropdown). */
  /* Base spacing for ALL ts-btn inside dropdown */
  &>.ts-btn {
    margin: var(--ts-nav-btn-block-gap) var(--ts-nav-btn-block-pad);
  }

  /* FIRST ts-btn (top breathing space correction) */
  &>.ts-btn:first-child,
  &> :not(.ts-btn)+.ts-btn {
    margin-top: var(--ts-nav-btn-block-pad);
  }

  /* LAST ts-btn (bottom breathing space correction) */
  &>.ts-btn:not(:has(+ .ts-btn)) {
    margin-bottom: var(--ts-nav-btn-block-pad);
  }

  &>.ts-btn:first-child,
  &> :not(.ts-btn)+.ts-btn {
    margin-top: var(--ts-nav-btn-block-pad);
  }

  &>.ts-btn:not(:has(+ .ts-btn)) {
    margin-bottom: var(--ts-nav-btn-block-pad);
  }
}






/* ── 5.75  FLOATING BACK-TO-TOP (desktop, owner 2.2 breakpoint ≥867px). Detaches
   into a FIXED bottom-right square, hidden (faded + slid out) until ts-nav.js
   adds .active on scroll. Below 868px the responsive block above keeps it inline
   in the bar instead. ── */
@media (min-width: 867px) {

  #ts-top-btn,
  .ts-back_top-nav {
    position: fixed;
    inset: auto var(--ts-sp-5) var(--ts-sp-5) auto;
    display: inline-flex;
    width: var(--ts-nav-icon-item-w);
    height: var(--ts-nav-icon-item-w);
    aspect-ratio: 1;
    border: 1px solid var(--ts-nav-border);
    border-radius: var(--ts-nav-btn-radius);
    background-color: var(--ts-bg-2);
    color: var(--ts-navlink-color);
    z-index: var(--ts-z-panel);
    z-index: 99999999;
    opacity: 0;
    pointer-events: none;
    transform: translateX(140%);
    transition: opacity var(--ts-dur-base) var(--ts-ease-out),
      transform var(--ts-dur-base) var(--ts-panel-ease-in),
      color var(--ts-dur-fast) var(--ts-ease-out);
  }

  #ts-top-btn.active,
  #ts-top-btn.ts-active,
  .ts-back_top-nav.active,
  .ts-back_top-nav.ts-active {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  #ts-top-btn:hover,
  .ts-back_top-nav:hover {
    color: var(--ts-navlink-color-active);
    border-color: var(--ts-this-bg-border-hover);
  }
}

body.ts-has-sidenav {
  margin: 0;
  min-height: 100dvh;
  display: grid;
  grid-template-columns: var(--ts-sidebar-nav-w, 200px) minmax(0, 1fr);
  align-items: stretch;
}

body.ts-has-sidenav> :is(main, .ts-main, .ts-container) {
  min-width: 0;
  padding: var(--ts-nav-pad-inline);
  overflow-y: auto;
  max-height: 100dvh;
}

/* ╔═══════════════════════════════════════════════════════════════════════════
   ║ SIDEBAR DRAFT:  this section lacks several code  blocks.
   ╚═══════════════════════════════════════════════════════════════════════════ */
.ts-sidebar-menu {
  position: sticky;
  top: 0;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  gap: var(--ts-sp-1);
  padding-block: var(--ts-sp-3);
  background-color: var(--ts-this-bg);
  border-right: 1px solid var(--ts-this-bg-border);

  & .ts-topbar__logo {
    flex-direction: column;
    align-items: flex-start;
    height: auto;
    padding: var(--ts-sp-2) var(--ts-sp-4) var(--ts-sp-4);
    font-size: var(--ts-fs-md);
  }

  & .ts-nav-fixed__links,
  & .ts-mobile-menu-items {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  & .ts-nav-fixed__links> :is(a, li, button, .ts-nav-item):not(.ts-btn) {
    height: auto;
    justify-content: flex-start;
    border: 0;
    padding: var(--ts-navlink-pad-y-mult) var(--ts-sp-4);

    &::after {
      left: 0;
      top: 0;
      bottom: 0;
      width: var(--ts-index-bar-height);
      height: auto;
      right: auto;
    }
  }

  & .theme-toggle,
  & .ts-back_top-nav,
  & #ts-top-btn {
    border-left: 0;
    align-self: flex-start;
    margin: var(--ts-sp-2) var(--ts-sp-4);
  }
}


/* ╔═══════════════════════════════════════════════════════════════════════════
   ║ LAYER 6 — SUB-ELEMENTS
   ╚═══════════════════════════════════════════════════════════════════════════ */
.ts-menu-text {
  line-height: initial;
}


/* ╔═══════════════════════════════════════════════════════════════════════════
   ║ LAYER 7 — THEME TOGGLE ANIMATION  (toggles.dev "expand" variant)
   ║ Imported from https://toggles.dev/expand — the ANIMATION only; layout/sizing
   ║ is owned by LAYER 4. OWNER DECISION: sun body = currentColor, rays = accent.
   ║ The project's global reduced-motion system (data-ts-reduced-motion) governs
   ║ motion, so the vendor !important reduced-motion rule was dropped.
   ╚═══════════════════════════════════════════════════════════════════════════ */
.theme-toggle__expand {
  fill: currentColor;
}

.theme-toggle__expand g circle,
.theme-toggle__expand g path {
  fill: currentColor;
}

/* single-color glyph (owner 2.2) */

.theme-toggle {
  --theme-toggle__expand--duration: 1500ms;
}

.theme-toggle.theme-toggle--reversed .theme-toggle__expand {
  transform: scale(-1, 1);
}

.theme-toggle__expand g circle,
.theme-toggle__expand g path {
  transform-origin: center;
  transition: transform calc(var(--theme-toggle__expand--duration) * 0.65) cubic-bezier(0, 0, 0, 1.25) calc(var(--theme-toggle__expand--duration) * 0.35);
}

.theme-toggle__expand :first-child path {
  transition-property: transform, d;
  transition-duration: calc(var(--theme-toggle__expand--duration) * 0.6);
  transition-timing-function: cubic-bezier(0, 0, 0.5, 1);
}

.theme-toggle input[type="checkbox"]:checked~.theme-toggle__expand g circle,
.theme-toggle--toggled:not(label).theme-toggle .theme-toggle__expand g circle {
  transform: scale(1.4);
  transition-delay: 0s;
}

.theme-toggle input[type="checkbox"]:checked~.theme-toggle__expand g path,
.theme-toggle--toggled:not(label).theme-toggle .theme-toggle__expand g path {
  transform: scale(0.75);
  transition-delay: 0s;
}

.theme-toggle input[type="checkbox"]:checked~.theme-toggle__expand :first-child path,
.theme-toggle--toggled:not(label).theme-toggle .theme-toggle__expand :first-child path {
  d: path("M-9 3h25a1 1 0 0017 13v30H0Z");
  transition-delay: calc(var(--theme-toggle__expand--duration) * 0.4);
  transition-timing-function: cubic-bezier(0, 0, 0, 1.25);
}

@supports not (d: path("")) {

  .theme-toggle input[type="checkbox"]:checked~.theme-toggle__expand :first-child path,
  .theme-toggle--toggled:not(label).theme-toggle .theme-toggle__expand :first-child path {
    transform: translate3d(-9px, 14px, 0);
  }
}


/* ═══════════════════════════════════════════════════════════════════════════
   TODO (owner call #5) — ts-btn_v3 consolidation, NOT done here:
   The owner's `.ts-btn--outline / --ghost` token rework + on-surface-auto color
   swap belongs in components/ts-btn_v3.1.css, not in the nav file. Tracked for a
   dedicated buttons-v3 pass (merge text sizing + scaling + gradient + accent +
   this-bg so buttons inherit system tokens without crafting new scaling/color
   tokens). Source preserved in uploads/ts-nav-header_2.css (tail).

   DEFERRED here (owner calls #3, #4): floating fixed back-to-top variant; full
   ts-ui-select internals (dropdown sizing, search, options) + the :root
   --ts-ui-select-dd-* height calc — those move with the ts-ui-select migration.
   ═══════════════════════════════════════════════════════════════════════════ */