{
  "_comment": "Merge these hook entries into the project .claude/settings.json. Do NOT overwrite existing settings — add the hooks block. Paths are relative to project root.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-rehydrate.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/checkpoint-logger.mjs"
          }
        ]
      }
    ]
  }
}
